// This file is used to configure the Cloudflare Workers project using Wrangler.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-llm-proxy",
  "main": "src/index.ts",
  // Compatibility dates
  // Docs: https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-07-16",
  // Compatibility flags
  // Docs: https://developers.cloudflare.com/workers/configuration/compatibility-flags/
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs
  // Docs: https://developers.cloudflare.com/workers/observability/logs/workers-logs/
  "observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  // Smart Placement
  // Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/
  "placement": {
    "mode": "off"
  },
  // Serve the Worker on https://<name>.<subdomain>.workers.dev.
  // Flip "env.production"."workers_dev" to false once a custom domain is
  // attached so the raw workers.dev URL stops serving production traffic.
  "workers_dev": true,
  // Per-version preview URLs (<version>-<name>.workers.dev) are unnecessary
  // public exposure for a production API proxy — disable them.
  "preview_urls": false,
  "vars": {
    "BASE_URL": "http://localhost:8787",
    "ENVIRONMENT": "development",
    // Log verbosity: debug | info | warn | error. Unset defaults to
    // `debug` in development and `info` in production.
    "LOG_LEVEL": "debug",
    "SESSION_CACHE_TTL_SECONDS": "60",
    "RATE_LIMITER_SHARDS": "4",
    "METRICS_BUFFER_SHARDS": "4",
    "APP_NAME": "Open LLM Proxy",
    // Repository shown on the landing page (empty = built-in default).
    "GITHUB_REPO_URL": "",
    // Initial admin account — consumed ONLY when the database is empty
    // (first boot). The email cannot be changed from the portal afterwards.
    "INITIAL_ADMIN_EMAIL": "",
    "INITIAL_ADMIN_PASSWORD": "",
    "DASHBOARD_URL": "http://localhost:5173"
  },
  // Cron trigger for the alerting engine (Phase 5.3): evaluate spend +
  // error-rate alerts for all tenants every 5 minutes.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Admin dashboard SPA (Phase 2.2). Built by `npm run build:dashboard`;
  // the Worker serves it through the ASSETS binding so /api and /v1 keep
  // going through the Hono app / legacy V1 chain respectively.
  "assets": {
    "directory": "./dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "EMAIL_TEMPLATE_CACHE",
        "class_name": "EmailingCacheDO"
      },
      {
        "name": "METRICS_BUFFER",
        "class_name": "MetricsBuffer"
      },
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      },
      {
        "name": "RESPONSE_CACHE",
        "class_name": "ResponseCache"
      },
      {
        "name": "SESSION_MANAGER",
        "class_name": "SessionManager"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2.0",
      "new_sqlite_classes": [
        "EmailingCacheDO",
        "MetricsBuffer",
        "RateLimiter",
        "ResponseCache",
        "SessionManager"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-llm-proxy",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION_CACHE",
      "id": "00000000000000000000000000000000"
    }
  ],
  // Production environment configuration
  // For automated CI/CD deployments via Cloudflare Dashboard (Workers Builds / Git integration),
  // sensitive values (real domain URLs, production D1/KV bindings, secrets) are configured
  // directly in the Cloudflare Dashboard (Settings -> Variables and Secrets / Bindings)
  // so this public open-source repository contains only placeholders.
  //
  // NOTE: bindings, triggers, migrations, and assets are NON-inheritable keys:
  // each environment must declare them itself or they are silently dropped
  // (wrangler warns for durable_objects only). Keep this section in sync with
  // the top-level configuration above.
  "env": {
    "production": {
      // Set to false once a custom domain is attached (see DEPLOYMENT.md
      // Step 6) so production traffic only reaches your own domain.
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "BASE_URL": "https://your-domain.com",
        "ENVIRONMENT": "production",
        "LOG_LEVEL": "info",
        "DASHBOARD_URL": "https://your-domain.com",
        "SESSION_CACHE_TTL_SECONDS": "3600",
        "RATE_LIMITER_SHARDS": "8",
        "METRICS_BUFFER_SHARDS": "8",
        "APP_NAME": "Open LLM Proxy",
        "GITHUB_REPO_URL": "",
        "INITIAL_ADMIN_EMAIL": "",
        "INITIAL_ADMIN_PASSWORD": ""
      },
      // Cron trigger for the alerting engine (spend + error-rate alerts).
      "triggers": {
        "crons": ["*/5 * * * *"]
      },
      // Admin dashboard SPA served through the ASSETS binding.
      "assets": {
        "directory": "./dashboard/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application"
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "EMAIL_TEMPLATE_CACHE",
            "class_name": "EmailingCacheDO"
          },
          {
            "name": "METRICS_BUFFER",
            "class_name": "MetricsBuffer"
          },
          {
            "name": "RATE_LIMITER",
            "class_name": "RateLimiter"
          },
          {
            "name": "RESPONSE_CACHE",
            "class_name": "ResponseCache"
          },
          {
            "name": "SESSION_MANAGER",
            "class_name": "SessionManager"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v2.0",
          "new_sqlite_classes": [
            "EmailingCacheDO",
            "MetricsBuffer",
            "RateLimiter",
            "ResponseCache",
            "SessionManager"
          ]
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "open-llm-proxy-prod",
          "database_id": "00000000-0000-0000-0000-000000000000"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "SESSION_CACHE",
          "id": "00000000000000000000000000000000"
        }
      ]
    }
  }
}
